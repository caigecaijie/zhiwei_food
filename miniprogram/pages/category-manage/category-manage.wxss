.page {
  padding: 24rpx;
}

.add-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 24rpx;
}

.add-input {
  flex: 1;
  font-size: 28rpx;
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.add-btn {
  background: #FF6B35;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 16rpx 32rpx;
  margin-left: 16rpx;
}

.empty-tip {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 120rpx 0;
}

.cat-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.cat-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  border-bottom: 2rpx solid #F5F5F5;
}

.cat-item:last-child {
  border-bottom: none;
}

.cat-info {
  display: flex;
  flex-direction: column;
}

.cat-name {
  font-size: 30rpx;
  font-weight: 500;
}

.cat-count {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.cat-actions {
  display: flex;
  align-items: center;
}

.act {
  font-size: 24rpx;
  color: #666;
  background: #F5F5F5;
  border-radius: 8rpx;
  padding: 8rpx 18rpx;
  margin-left: 12rpx;
}

.act.disabled {
  opacity: 0.4;
}

.act.danger {
  color: #E64340;
}
