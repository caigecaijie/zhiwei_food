/** order-list 页面样式 */
.page {
  padding: 0 24rpx 24rpx;
  box-sizing: border-box;
}

.tabs {
  position: sticky;
  top: 0;
  z-index: 5;
  display: flex;
  background: var(--bg);
  padding: 20rpx 0;
  gap: 12rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-sub);
  padding: 12rpx 0;
  border-radius: 999rpx;
  background: #fff;
}

.tab.active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.empty-wrap {
  padding-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.go-btn {
  width: 300rpx;
}

.orders {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order {
  padding: 24rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-no {
  font-size: 24rpx;
  color: var(--text-sub);
}

.order-status {
  font-size: 26rpx;
  font-weight: 600;
}

.order-body {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.covers {
  display: flex;
  gap: 12rpx;
}

.cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}

.cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.cover.more {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-sub);
  font-size: 26rpx;
  background: #F5F5F5;
}

.order-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.count {
  font-size: 28rpx;
  font-weight: 600;
}

.time {
  font-size: 22rpx;
  color: var(--text-sub);
}

.party-flag {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #F5F5F5;
  font-size: 22rpx;
  color: var(--primary);
}
