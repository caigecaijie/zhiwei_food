.page {
  padding: 24rpx;
}

.input-card {
  padding: 24rpx;
}

.input-card .section-title {
  margin-top: 0;
}

/* 已选食材 */
.selected-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.chip {
  display: inline-block;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #F5F6F8;
  color: var(--text-main);
  margin: 0;
}

.chip-selected {
  background: var(--primary-light);
  color: var(--primary);
}

.chip-clear {
  background: transparent;
  color: var(--text-sub);
}

.selected-empty {
  font-size: 26rpx;
  color: var(--text-sub);
  margin-bottom: 24rpx;
}

/* 输入行 */
.input-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ing-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #F5F6F8;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.add-btn {
  width: 140rpx;
  height: 72rpx;
  line-height: 68rpx;
  padding: 0;
  font-size: 28rpx;
  color: var(--primary);
  background: #fff;
  border: 2rpx solid var(--primary);
  border-radius: 999rpx;
}

/* 常用食材 */
.common-title {
  font-size: 26rpx;
  color: var(--text-sub);
  margin: 28rpx 0 16rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip-active {
  background: var(--primary);
  color: #fff;
}

/* 匹配按钮 */
.match-btn {
  margin: 32rpx 0;
}

/* 结果列表 */
.result-item {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.item-hover {
  opacity: 0.85;
}

.cover {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #F0F0F0;
}

.info {
  flex: 1;
  margin-left: 20rpx;
  overflow: hidden;
}

.title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.match-line {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-bottom: 6rpx;
}

.match-num {
  color: var(--primary);
  font-weight: 600;
}

.missing {
  font-size: 24rpx;
  color: var(--danger);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  font-size: 24rpx;
  color: var(--text-sub);
}

.bottom-space {
  height: 40rpx;
}
