/** recipe-detail 页面样式 */
.page {
  padding-bottom: 40rpx;
}

.cover {
  width: 100%;
  height: 480rpx;
  display: block;
}

.cover-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  background: var(--primary-light);
  box-sizing: border-box;
}

.head {
  margin: -60rpx 24rpx 0;
  position: relative;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  flex: 1;
  color: var(--text-main);
}

.tag.private {
  color: var(--text-sub);
  background: #F0F0F0;
}

.desc {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.meta {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--text-sub);
}

.tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.author {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #eee;
}

.author-name {
  font-size: 26rpx;
  color: var(--text-sub);
}

.creator-ops {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F0F0F0;
  display: flex;
  gap: 24rpx;
}

.op-btn {
  font-size: 26rpx;
  color: var(--primary);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--primary-light);
}

.op-btn.danger {
  color: var(--danger);
  background: #FDECEC;
}

/* 内容块 */
.block {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
}

.block-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.ing-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.ing-row:last-child {
  border-bottom: none;
}

.ing-name {
  font-size: 28rpx;
  color: var(--text-main);
}

.ing-amount {
  font-size: 28rpx;
  color: var(--text-sub);
}

.step {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
}

.step-no {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.step-body {
  flex: 1;
}

.step-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--text-main);
}

.step-img {
  margin-top: 16rpx;
  width: 100%;
  border-radius: 12rpx;
}

.tips {
  font-size: 28rpx;
  line-height: 1.7;
  color: #666;
}

/* 底部 */
.bottom-space {
  height: 160rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 24rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 10;
}

.share-btn {
  flex: 1;
  margin: 0;
  line-height: inherit;
  font-size: 30rpx;
}

.share-btn::after {
  border: none;
}

.cart-btn {
  flex: 2;
}

/* 加载失败 */
.fail-wrap {
  padding: 120rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.retry-btn {
  width: 300rpx;
}
