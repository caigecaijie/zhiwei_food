<view class="page">
  <!-- 用户资料卡 -->
  <view class="card user-card">
    <view class="user-row">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar" src="{{form.avatarUrl}}" mode="aspectFill" />
        <view class="avatar-tip">换头像</view>
      </button>
      <view class="form-col">
        <input
          class="nickname-input"
          type="nickname"
          placeholder="填写昵称"
          placeholder-class="input-placeholder"
          value="{{form.nickName}}"
          bindinput="onNicknameInput"
        />
        <input
          class="bio-input"
          placeholder="一句话介绍自己（选填）"
          placeholder-class="input-placeholder"
          value="{{form.bio}}"
          bindinput="onBioInput"
        />
      </view>
    </view>
    <button class="btn-primary save-btn {{saving ? 'disabled' : ''}}" bindtap="onSave" disabled="{{saving}}">保存资料</button>
  </view>

  <!-- 统计 -->
  <view class="card stats-card">
    <view class="stat-item">
      <view class="stat-num">{{recipeCount}}</view>
      <view class="stat-label">我的菜谱</view>
    </view>
  </view>

  <!-- 菜单 -->
  <view class="card menu-card">
    <view class="menu-item" bindtap="goCategories" hover-class="menu-hover">
      <text class="menu-icon">📚</text>
      <text class="menu-name">分类管理</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goMatch" hover-class="menu-hover">
      <text class="menu-icon">🥕</text>
      <text class="menu-name">按食材配菜</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onClearCache" hover-class="menu-hover">
      <text class="menu-icon">🧹</text>
      <text class="menu-name">清除缓存</text>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="onAbout" hover-class="menu-hover">
      <text class="menu-icon">💡</text>
      <text class="menu-name">关于智味菜谱</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
