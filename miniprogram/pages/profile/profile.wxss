.page {
  padding: 24rpx;
}

/* 用户资料卡 */
.user-card {
  padding: 32rpx 24rpx 24rpx;
}

.user-row {
  display: flex;
  align-items: center;
}

.avatar-btn {
  width: 128rpx;
  height: 128rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  position: relative;
  flex-shrink: 0;
}

.avatar-btn::after {
  display: none;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #F0F0F0;
}

.avatar-tip {
  position: absolute;
  left: 0;
  right: 0;
  bottom: -4rpx;
  font-size: 18rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  border-radius: 0 0 999rpx 999rpx;
  padding: 2rpx 0;
  text-align: center;
}

.form-col {
  flex: 1;
  margin-left: 28rpx;
}

.nickname-input {
  font-size: 34rpx;
  font-weight: 600;
  height: 64rpx;
}

.bio-input {
  font-size: 26rpx;
  color: var(--text-sub);
  height: 56rpx;
  margin-top: 8rpx;
}

.input-placeholder {
  color: #C0C4CC;
}

.save-btn {
  margin-top: 28rpx;
}

/* 统计 */
.stats-card {
  margin-top: 24rpx;
  padding: 28rpx 0;
  display: flex;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
}

.stat-label {
  font-size: 24rpx;
  color: var(--text-sub);
  margin-top: 4rpx;
}

/* 菜单 */
.menu-card {
  margin-top: 24rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  border-bottom: 2rpx solid #F5F6F8;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-hover {
  background: #FAFAFA;
}

.menu-icon {
  font-size: 34rpx;
  margin-right: 20rpx;
}

.menu-name {
  flex: 1;
  font-size: 30rpx;
}

.arrow {
  font-size: 36rpx;
  color: #C0C4CC;
}
