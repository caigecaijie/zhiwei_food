/** order-detail 页面样式 */
.page {
  padding-bottom: 40rpx;
}

.status-head {
  padding: 48rpx 32rpx 40rpx;
  color: #fff;
}

.status-text {
  font-size: 44rpx;
  font-weight: 700;
}

.order-no {
  margin-top: 16rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.time {
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.8;
}

.block {
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
}

.party-line {
  font-size: 26rpx;
  color: var(--primary);
}

.block-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.item:last-child {
  border-bottom: none;
}

.cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.name {
  font-size: 30rpx;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.remark {
  font-size: 22rpx;
  color: var(--text-sub);
}

.from {
  font-size: 22rpx;
  color: var(--primary);
}

.qty {
  font-size: 28rpx;
  color: var(--text-sub);
  flex-shrink: 0;
}

.participants {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.p-chip {
  font-size: 24rpx;
  background: var(--bg);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  color: var(--text-main);
}

/* 底部操作 */
.bottom-space {
  height: 160rpx;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 24rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 10;
}

.cancel-btn {
  flex: 1;
}

.cook-btn {
  flex: 2;
}

.fail-wrap {
  padding: 120rpx 60rpx;
}
